{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Promptly Task Batch",
  "description": "Structured GitHub Issue proposals generated by the Codex planning skill.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string",
      "description": "Target PRD section, such as PRD-03."
    },
    "tasks": {
      "type": "array",
      "description": "Up to five atomic task proposals.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Stable identifier, e.g. PLAY-002."
          },
          "title": {
            "type": "string",
            "description": "Concise, action-oriented issue title."
          },
          "work_type": {
            "type": "string",
            "enum": [
              "Implementation",
              "Research",
              "Bug",
              "Documentation"
            ]
          },
          "area": {
            "type": "string",
            "description": "Area value from the GitHub Project."
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "PRD requirement IDs, e.g. F03.4."
          },
          "objective": {
            "type": "string",
            "description": "Single expected outcome."
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Work explicitly included."
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Observable completion conditions."
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Required tests and validation."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Blocking task IDs or GitHub issue references."
          },
          "out_of_scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Adjacent work explicitly excluded."
          },
          "notes": {
            "type": "string",
            "description": "Additional context; empty if none."
          }
        },
        "required": [
          "task_id",
          "title",
          "work_type",
          "area",
          "priority",
          "requirements",
          "objective",
          "scope",
          "acceptance_criteria",
          "verification",
          "dependencies",
          "out_of_scope",
          "notes"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unresolved decisions requiring review."
    }
  },
  "required": [
    "feature",
    "tasks",
    "open_questions"
  ]
}
